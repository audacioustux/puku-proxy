# Required. Comma-separated bearer tokens the proxy accepts on protected routes.
# Each request must send `Authorization: Bearer <token>`. Healthz stays open.
# The proxy refuses to start without this var set.
PUKU_PROXY_AUTH_KEYS=pk_live_replace_me

# Optional. Upstream auth — forwarded to the spawned puku-cli subprocess.
# If unset, puku-cli uses whatever's logged in via `puku-cli auth login`
# or falls back to its anonymous default routing.
PUKU_AI_API_KEY=

# Optional. Override the Puku SDK base URL (defaults to https://agent.sdk.puku.sh).
# Useful for self-hosted gateways or testing against a local puku-cli.
PUKU_BASE_URL=

# Port the proxy listens on. Defaults to 8787.
PORT=8787

# Optional. Largest accepted request body, in bytes. Defaults to 5000000 (5MB).
# Each request spawns a puku-cli subprocess, so this bounds how much work one
# caller can demand. Agent traffic with long tool-call histories is
# legitimately large — raise this rather than removing the limit. Requests
# over it get a 413 naming the actual and permitted sizes.
PUKU_PROXY_MAX_BODY_BYTES=

# Optional. Set to 1 (or true / yes) for verbose per-request debug logging.
# Request/response lines (method, path, status, duration) are always logged
# regardless of this setting; this adds signal state, heartbeat counts, and
# abort reasons for diagnosing streaming issues.
PUKU_PROXY_DEBUG=
