# Optional. If unset, puku-cli uses whatever's logged in via `puku-cli auth login`
# or falls back to its anonymous default routing.
PUKU_AI_API_KEY=

# Optional. Override the Puku SDK base URL (defaults to https://agent.sdk.puku.sh).
# Useful for self-hosted gateways or testing against a local puku-cli.
PUKU_BASE_URL=

# Port the proxy listens on. Defaults to 8787.
PORT=8787
